{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "~/Загрузки/tux.png",
        "width": 20,
        "height": 10,
        "padding": { "top": 1, "right": 4 }
    },

    "display": {
        "separator": "",
        "color": { "keys": "white", "values": "white" }
    },

    "modules": [
        "title",
        "break",

        // --- SYSTEM
        { "type": "custom", "format": "\u001b[36m╭──────────────╮╭───────────────────────────────────────╮\u001b[0m" },
        { "type": "os",       "key": "\u001b[36m│  OS         ││\u001b[0m", "format": "\u001b[97m {name}                                \u001b[36m│\u001b[0m" },
        { "type": "kernel",   "key": "\u001b[36m│  Kernel     ││\u001b[0m", "format": "\u001b[97m {sysname} {#2}                                \u001b[36m│\u001b[0m" },
        { "type": "uptime",   "key": "\u001b[36m│  Uptime     ││\u001b[0m", "format": "\u001b[97m {hours} hours, {minutes} mins                      \u001b[36m│\u001b[0m" },
        { "type": "command",  "key": "\u001b[36m│  OS Age     ││\u001b[0m", "format": "\u001b[97m {}                               \u001b[36m│\u001b[0m", "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days" },
        { "type": "packages", "key": "\u001b[36m│  Packages   ││\u001b[0m", "format": "\u001b[97m {all}                                  \u001b[36m│\u001b[0m" },
        { "type": "custom",   "format": "\u001b[36m╰──────────────╯╰───────────────────────────────────────╯\u001b[0m" },

        "break",

        // --- DESKTOP
        { "type": "custom", "format": "\u001b[34m╭──────────────╮╭───────────────────────────────────────╮\u001b[0m" },
        { "type": "wm",       "key": "\u001b[34m│   WM        ││\u001b[0m", "format": "\u001b[97m {1}                              \u001b[34m│\u001b[0m" },
        { "type": "terminal", "key": "\u001b[34m│   Term      ││\u001b[0m", "format": "\u001b[97m {pretty-name} {#2}{version}                          \u001b[34m│\u001b[0m" },
        { "type": "shell",    "key": "\u001b[34m│   Shell     ││\u001b[0m", "format": "\u001b[97m {exe-name} {#2}{version}                             \u001b[34m│\u001b[0m" },
        { "type": "display",  "key": "\u001b[34m│   Display   ││\u001b[0m", "format": "\u001b[97m {width}x{height} {refresh-rate} Hz                       \u001b[34m│\u001b[0m" },
        { "type": "command",  "key": "\u001b[34m│   Weather   ││\u001b[0m", "format": "\u001b[97m {}                           \u001b[34m│\u001b[0m", "text": "~/fastfetch/weather.sh" },
        { "type": "custom",   "format": "\u001b[34m╰──────────────╯╰───────────────────────────────────────╯\u001b[0m" },

        "break",

        // --- HARDWARE
        { "type": "custom", "format": "\u001b[35m╭──────────────╮╭───────────────────────────────────────╮\u001b[0m" },
        { "type": "cpu",      "key": "\u001b[35m│   CPU       ││\u001b[0m", "format": "\u001b[97m {name}             \u001b[35m│\u001b[0m" },
        { "type": "gpu",      "key": "\u001b[35m│ 󰢮  GPU       ││\u001b[0m", "format": "\u001b[97m {name}                       \u001b[35m│\u001b[0m" },
        { "type": "memory",   "key": "\u001b[35m│   RAM       ││\u001b[0m", "format": "\u001b[97m {used} / {total}                   \u001b[35m│\u001b[0m" },
        { "type": "swap",     "key": "\u001b[35m│   Swap      ││\u001b[0m", "format": "\u001b[97m {used} / {total}                        \u001b[35m│\u001b[0m" },
        { "type": "disk",     "key": "\u001b[35m│   Disk      ││\u001b[0m", "folders": "/", "format": "\u001b[97m {size-used} / {size-total} - {filesystem}         \u001b[35m│\u001b[0m" },
        { "type": "custom",   "format": "\u001b[35m╰──────────────╯╰───────────────────────────────────────╯\u001b[0m" },

        "break",
        
        // --- DISTRO ICONS FOOTER
        { "type": "custom", "format": "\u001b[31m   \u001b[32m   \u001b[33m   \u001b[34m   \u001b[35m   \u001b[36m   \u001b[37m   \u001b[38;5;208m   \u001b[38;5;196m   \u001b[32m  \u001b[0m" }
    ]
}
